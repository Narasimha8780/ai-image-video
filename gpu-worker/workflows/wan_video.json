{
  "unet_loader": {
    "class_type": "UNETLoader",
    "inputs": {
      "unet_name": "wan2.2_ti2v_5B_fp16.safetensors",
      "weight_dtype": "default"
    }
  },
  "model_sampling": {
    "class_type": "ModelSamplingSD3",
    "inputs": {
      "shift": 8.0,
      "model": ["unet_loader", 0]
    }
  },
  "clip_loader": {
    "class_type": "CLIPLoader",
    "inputs": {
      "clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors",
      "type": "wan",
      "device": "default"
    }
  },
  "vae_loader": {
    "class_type": "VAELoader",
    "inputs": {
      "vae_name": "wan2.2_vae.safetensors"
    }
  },
  "prompt_node": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "",
      "clip": ["clip_loader", 0]
    }
  },
  "negative_node": {
    "class_type": "CLIPTextEncode",
    "inputs": {
      "text": "overexposed, static, blurred details, subtitles, worst quality, low quality, JPEG compression, ugly, deformed, extra fingers, flicker, watermark, text",
      "clip": ["clip_loader", 0]
    }
  },
  "latent_video": {
    "class_type": "Wan22ImageToVideoLatent",
    "inputs": {
      "vae": ["vae_loader", 0],
      "width": 704,
      "height": 1280,
      "length": 121,
      "batch_size": 1
    }
  },
  "sampler_node": {
    "class_type": "KSampler",
    "inputs": {
      "seed": 42,
      "steps": 30,
      "cfg": 5.0,
      "sampler_name": "euler",
      "scheduler": "simple",
      "denoise": 1.0,
      "model": ["model_sampling", 0],
      "positive": ["prompt_node", 0],
      "negative": ["negative_node", 0],
      "latent_image": ["latent_video", 0]
    }
  },
  "vae_decode": {
    "class_type": "VAEDecode",
    "inputs": {
      "samples": ["sampler_node", 0],
      "vae": ["vae_loader", 0]
    }
  },
  "create_video": {
    "class_type": "CreateVideo",
    "inputs": {
      "images": ["vae_decode", 0],
      "fps": 24
    }
  },
  "save_video": {
    "class_type": "SaveVideo",
    "inputs": {
      "video": ["create_video", 0],
      "filename_prefix": "wan_cinematic",
      "format": "mp4",
      "codec": "h264"
    }
  }
}
