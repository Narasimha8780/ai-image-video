# Application Mode: "local" for local dev/in-memory+SQLite/local-fs, "gcp" for Cloud Run + Firestore + GCS + Cloud Tasks
APP_ENV=local
JWT_SECRET=dev-secret-change-in-production
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# GCP Settings (used when APP_ENV=gcp)
GCP_PROJECT_ID=ai-creator-studio-123456
GCP_REGION=us-central1
GCS_BUCKET=ai-models
CLOUD_TASKS_QUEUE=ai-studio-jobs
CLOUD_RUN_IMAGE_JOB=ai-image-worker
CLOUD_RUN_VIDEO_JOB=ai-video-worker
BACKEND_PUBLIC_URL=https://ai-studio-api-xxxx.a.run.app

# Local Dev Simulation
LOCAL_STORAGE_DIR=./local_data/storage
LOCAL_DB_PATH=./local_data/studio.db
LOCAL_SIMULATE_GPU=true

# Optional External Premium Providers (store in Secret Manager in production)
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.ap-southeast.byteplusapi.com/api/v3
KLING_API_KEY=
KLING_BASE_URL=https://api.klingai.com/v1
